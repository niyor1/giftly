# ─── Ollama Configuration ──────────────────────────────────────────
# Base URL of the local Ollama instance
OLLAMA_URL=http://localhost:11434/api/chat

# Model to use for gift generation (must be pulled locally via `ollama pull <model>`)
OLLAMA_MODEL=qwen3:35b

# Request timeout in milliseconds (default 60s)
# Ollama can take a while for large models — don't lower this unless you have a fast GPU
FETCH_TIMEOUT=60000
